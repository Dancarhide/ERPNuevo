# ==============================================================================
# ARCHIVO DE ENTORNO PRINCIPAL (PRODUCCIÓN - DOCKER COMPOSE)
# ==============================================================================
# Este archivo es el ÚNICO que necesitas configurar cuando instales el ERP
# en el servidor de un cliente usando el script de "One-Click" (docker-compose).
# Automáticamente pasará estas variables hacia los contenedores de backend y frontend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (POSTGRESQL)
# ------------------------------------------------------------------------------
# Si no proporcionas esto: El despliegue de Docker creará una base de datos 
# por defecto llamada 'erpnuevo' con contraseñas por defecto, lo cual es MUY 
# inseguro en producción. SIEMPRE cambia la contraseña para cada cliente.
DB_USER=postgres
DB_PASSWORD=una_contraseña_muy_segura_aqui
DB_NAME=erp_empresa_x

# ------------------------------------------------------------------------------
# 2. SEGURIDAD Y SESIONES (JWT)
# ------------------------------------------------------------------------------
# Si no proporcionas esto: El backend usará una llave secreta por defecto en 
# su código. Esto significa que alguien con acceso al código fuente podría 
# generar tokens de acceso falsos y vulnerar la seguridad del cliente.
# RECOMENDACIÓN: Genera una cadena larga aleatoria (ej. usando un gestor de contraseñas)
JWT_SECRET=escribe_aqui_una_cadena_aleatoria_muy_larga_y_compleja

# ------------------------------------------------------------------------------
# 3. DOMINIO Y EXPOSICIÓN A INTERNET (FRONTEND)
# ------------------------------------------------------------------------------
# 3. FRONTEND (CONFIGURACIÓN WEB)
# ------------------------------------------------------------------------------
# DOMAIN: El dominio oficial donde vivirá el sistema web en internet.
DOMAIN=zapatos.mi-erp-ventas.com

# NEXT_PUBLIC_API_URL: (OPCIONAL) La URL base que utilizará el frontend en el navegador para comunicarse.
# Por defecto el docker-compose lo autocompleta como "https://${DOMAIN}", por lo que en producción NO es
# necesario llenarlo. PERO si estás probando en red local (ej. celular), debes forzar el HTTP aquí:
# NEXT_PUBLIC_API_URL=http://192.168.0.75:3000

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE TUNNEL (RED ZERO-TRUST)
# ------------------------------------------------------------------------------
# Este token conecta el servidor físico del cliente con tu panel de Cloudflare 
# para exponer el ERP a internet de manera segura, sin abrir puertos en el módem.
CLOUDFLARE_TUNNEL_TOKEN=ey...

# ------------------------------------------------------------------------------
# 5. CONFIGURACIONES OPERATIVAS Y MODOS DE PRUEBA (IMPORTANTE)
# ------------------------------------------------------------------------------
# CREDENCIALES PAC (PROVEEDOR AUTORIZADO DE CERTIFICACIÓN PARA EL SAT):
# - Si la empresa YA TIENE contrato con un PAC: Llene los 3 datos de abajo (PAC_URL, USER, PASSWORD)
#   para que el ERP timbre automáticamente los recibos ante el SAT.
# - Si la empresa NO TIENE un PAC: Deje las 3 variables vacías. El ERP funcionará 
#   como una calculadora avanzada: le dará las retenciones y cuotas exactas, 
#   y el contador deberá capturar esos números a mano en el portal del SAT.
PAC_URL=https://pruebas.pac-ejemplo.com/api/timbrar
PAC_USER=usuario_pruebas
PAC_PASSWORD=password_pruebas

# PAC_TEST_MODE: Si está en True, el ERP simulará el timbrado de nómina (No gasta folios ni afecta al SAT real).
# Cambiar a 'False' ÚNICAMENTE cuando la empresa ya esté operando y lista para timbrar nóminas reales.
PAC_TEST_MODE=True

# TEST_MODE_CHECADOR: Si está en True, el sistema permite simular "checar entrada/salida" 
# desde la interfaz web sin validar restricciones de hardware ni tokens reales, útil para pruebas de nómina.
# En Producción real, debería cambiarse a False para forzar el uso del ZKTeco o validaciones estrictas.
TEST_MODE_CHECADOR=False
