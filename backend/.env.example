# ==============================================================================
# ARCHIVO DE ENTORNO DEL BACKEND (DESARROLLO LOCAL)
# ==============================================================================
# Este archivo es exclusivamente para cuando TÚ o tus programadores estén 
# desarrollando código en su máquina local (usando `uv run uvicorn`).
# En Producción (Docker), estas variables se inyectan automáticamente desde 
# el .env de la raíz del proyecto.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS
# ------------------------------------------------------------------------------
# Configuración para que el código local se conecte a tu Postgres local.
# Qué pasa si falla: Alembic y FastAPI no arrancarán, arrojando "ConnectionRefused".
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=erp_local
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. REDIS (CACHÉ Y WEBSOCKETS PUB/SUB)
# ------------------------------------------------------------------------------
# Usado para sincronizar los WebSockets entre diferentes hilos y workers.
# Qué pasa si falla: Los mensajes de los relojes checadores no llegarán en 
# tiempo real a todos los navegadores conectados.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. SEGURIDAD (JWT Y CORS)
# ------------------------------------------------------------------------------
# SECRET_KEY: Llave de encriptación de sesiones. 
# BACKEND_CORS_ORIGINS: Lista JSON estricta de dominios que pueden hacer peticiones a la API.
# Qué pasa si falla: Si el CORS está mal configurado, el navegador bloqueará 
# todas las respuestas con un error "CORS policy blocked".
SECRET_KEY=clave_secreta_para_desarrollo_local_123
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ------------------------------------------------------------------------------
# 📄 4. TIMBRADO DE NÓMINA (PAC - FACTURACIÓN ELECTRÓNICA)
# ------------------------------------------------------------------------------
# Credenciales del Proveedor Autorizado de Certificación (PAC) para timbrar XMLs ante el SAT.
# ¿Qué pasa si no tengo PAC?: Puedes dejar PAC_URL, PAC_USER y PAC_PASSWORD vacíos.
# En ese caso, el ERP actuará como una calculadora pura: calculará impuestos y cuotas,
# pero los pagos y el timbrado deberán realizarse manualmente en el portal del SAT.
#
# PAC_TEST_MODE=True asegura que los timbres sean "de mentira" para no gastar folios.
PAC_URL=https://pruebas.pac-ejemplo.com/api/timbrar
PAC_USER=usuario_pruebas
PAC_PASSWORD=password_pruebas
PAC_TEST_MODE=True
