# ==========================================
# CONFIGURACIÓN GENERAL DEL BACKEND
# ==========================================
# Nombre del proyecto (Opcional, usado para documentación interactiva de Swagger)
PROJECT_NAME="ERP Nuevo API"

# Llave secreta para firmar los tokens JWT. 
# QUÉ PASA SI FALTA: Usará una llave insegura por defecto ("super_secret_..."). 
# IMPORTANTE: En producción siempre debes cambiar esto a una cadena larga y aleatoria o los tokens serán hackeables.
SECRET_KEY="cambia_esto_por_una_llave_segura_en_produccion"

# Tiempo de expiración del token JWT de sesión (en minutos).
# QUÉ PASA SI FALTA: Por defecto es 1440 (24 horas).
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# Orígenes permitidos (CORS) que pueden hacer peticiones al backend.
# QUÉ PASA SI FALTA: Permitirá una lista vacía y los navegadores bloquearán las llamadas desde dominios no autorizados.
# NOTA: Debes incluir la URL donde se aloja el frontend.
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ==========================================
# CONFIGURACIÓN DE LA BASE DE DATOS (POSTGRESQL)
# ==========================================
# Dirección del servidor de PostgreSQL.
# QUÉ PASA SI FALTA: El sistema asume "localhost". Si la BD está en otro lado, el sistema fallará al arrancar.
POSTGRES_SERVER="localhost"

# Usuario de la base de datos.
# QUÉ PASA SI FALTA: Asume "postgres".
POSTGRES_USER="postgres"

# Contraseña de la base de datos.
# QUÉ PASA SI FALTA: Asume "postgres" (riesgo de seguridad).
POSTGRES_PASSWORD="tu_password_seguro"

# Nombre de la base de datos.
# QUÉ PASA SI FALTA: Asume "erp".
POSTGRES_DB="erp_db"

# Puerto de PostgreSQL.
# QUÉ PASA SI FALTA: Asume el puerto por defecto "5432".
POSTGRES_PORT="5432"

# ==========================================
# CONFIGURACIÓN DEL TIMBRADO (PAC)
# ==========================================
# URL, Usuario y Contraseña proporcionados por tu Proveedor Autorizado de Certificación.
# ¿QUÉ PASA SI ESTÁN VACÍAS O NO ESTÁN? 
#   El ERP funcionará perfectamente como una herramienta interna de administración y cálculo de "Pre-Nómina". 
#   Generará los PDFs y los totales correctos para que el contador los copie al portal del SAT manualmente. 
#   Pero si el usuario intenta hacer clic en "Timbrar", el sistema arrojará un error indicando que falta el proveedor,
#   bloqueando el proceso para evitar generar comprobantes ilegales.
PAC_URL=""
PAC_USER=""
PAC_PASSWORD=""

# Modo de pruebas para el timbrado (True/False).
# ¿QUÉ PASA SI FALTA O ESTÁ VACÍA? Asume "True". 
# IMPORTANTE: En producción real, debes asegurarte de ponerlo en "False" o quitarlo, para evitar que el sistema 
# simule un timbrado falso si las credenciales de arriba fallan o no se ponen.
PAC_TEST_MODE="True"
